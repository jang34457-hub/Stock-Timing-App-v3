# development: leave API_SECRET_KEY empty so the local app works without X-API-Key.
APP_ENV=development
API_SECRET_KEY=
CORS_ALLOW_ORIGINS=*

# production:
# APP_ENV=production
# API_SECRET_KEY=replace-with-a-long-random-string
# CORS_ALLOW_ORIGINS=http://localhost:8081
# JOB_RUNNER=external
# SCHEDULER_ENABLED=0

# Job runner (STEP 18-2)
# development: FastAPI 안 APScheduler (기본 JOB_RUNNER=inprocess, 평일 16:00 KST)
# production: GitHub Actions 또는 python scripts/job_worker.py
#   같은 잡을 FastAPI와 Actions가 둘 다 돌리면 SMS가 중복될 수 있음.
# JOB_RUNNER=external
# SCHEDULER_HOUR=16
# SCHEDULER_MINUTE=0
# 전용 worker: python scripts/job_worker.py  (JOB_RUNNER를 inprocess로 강제)

# Supabase Postgres (Session pooler URI from Project Settings → Database).
# Local verify_* scripts stay on SQLite unless APP_ENV=production or STA_USE_POSTGRES=1.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
# SUPABASE_DB_URL=  # alias for DATABASE_URL
# STA_USE_POSTGRES=1
# STA_FORCE_SQLITE=1

# SMS (STEP 18-3)
# SMS_PROVIDER=test
# SMS_PROVIDER=solapi
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=01000000000
# SMS_RETRY_MAX=3
# SMS_RETRY_BACKOFF_SEC=1
# 실제 테스트 문자: POST /sms/test  body {"live": true}  (기본은 로그 전용)
# STA_LIVE_SMS=1
